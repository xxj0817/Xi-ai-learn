# 复制为 backend/.env 后按需修改；.env 不会进入版本库
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# mock: 无需 Key 即可跑通全流程；deepseek: 真实调用
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_THINKING_ENABLED=false
# 默认不读取系统 HTTP_PROXY/HTTPS_PROXY，避免残留的失效代理导致连接失败
DEEPSEEK_TRUST_ENV_PROXY=false
# 需要走代理时填写，例如 http://127.0.0.1:7890；留空表示直连
DEEPSEEK_PROXY_URL=
LLM_MAX_ATTEMPTS=2

QUIZ_DEFAULT_QUESTION_COUNT=5
QUIZ_MIN_INPUT_CHARS=2
QUIZ_MAX_INPUT_CHARS=2000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

CORS_ORIGINS=["http://localhost:10086","http://127.0.0.1:10086"]

# ==================== MySQL ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xi_ai_learn
MYSQL_POOL_MIN_SIZE=1
MYSQL_POOL_MAX_SIZE=10

# ==================== JWT ====================
# 生产环境请用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
JWT_SECRET=change-me-to-a-random-48-byte-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ==================== 微信小程序 ====================
# 需与 frontend/project.config.json 中的 appid 保持一致
WECHAT_APPID=
# 微信公众平台 -> 开发管理 -> 开发设置 -> 开发者ID -> AppSecret
WECHAT_APP_SECRET=