# 复制为 backend/.env 后按需修改；.env 不会进入版本库
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# mock: 无需 Key 即可跑通全流程；deepseek: 真实调用
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_THINKING_ENABLED=false
# 默认不读取系统 HTTP_PROXY/HTTPS_PROXY，避免残留的失效代理导致连接失败
DEEPSEEK_TRUST_ENV_PROXY=false
# 需要走代理时填写，例如 http://127.0.0.1:7890；留空表示直连
DEEPSEEK_PROXY_URL=
LLM_MAX_ATTEMPTS=2

QUIZ_DEFAULT_QUESTION_COUNT=5
QUIZ_MIN_INPUT_CHARS=2
QUIZ_MAX_INPUT_CHARS=2000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

CORS_ORIGINS=["http://localhost:10086","http://127.0.0.1:10086"]

# ==================== MySQL ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xi_ai_learn
MYSQL_POOL_MIN_SIZE=1
MYSQL_POOL_MAX_SIZE=10

# ==================== JWT ====================
# 生产环境请用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
JWT_SECRET=change-me-to-a-random-48-byte-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ==================== 微信小程序 ====================
# 需与 frontend/project.config.json 中的 appid 保持一致
WECHAT_APPID=
# 微信公众平台 -> 开发管理 -> 开发设置 -> 开发者ID -> AppSecret
WECHAT_APP_SECRET=

# ==================== 联网检索（Tavily） ====================
# 总开关；关闭后不启动研究 Agent，直接使用模型知识出题
WEB_SEARCH_ENABLED=true
# tavily / none
WEB_SEARCH_PROVIDER=tavily
# 从 https://app.tavily.com 获取；留空时自动降级为纯模型出题
# 真实 Key 只能写到 backend/.env，本文件会进入版本库
# 用户提供的网址会发送给 Tavily Extract 抓取正文；粘贴文本不会发送给检索服务
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# 需要走代理时填写，例如 http://127.0.0.1:7890；留空表示直连
TAVILY_PROXY_URL=
# true 时使用系统已有 HTTP(S)_PROXY；默认 false 避免残留代理
TAVILY_TRUST_ENV_PROXY=false

# --- 工具预设（一般无需修改） ---
# Tavily 的 country 只支持国家级，不支持城市级；城市语义请写进查询词
TAVILY_TOOL_TIMEOUT_SECONDS=10
TAVILY_SEARCH_RESULT_MAX_CHARS=4000
TAVILY_EXTRACT_RESULT_MAX_CHARS=15000
TAVILY_TOOL_TOTAL_MAX_CHARS=24000
TAVILY_QUICK_MAX_RESULTS=4
TAVILY_QUICK_SEARCH_DEPTH=basic
TAVILY_DEEP_MAX_RESULTS=5
TAVILY_DEEP_SEARCH_DEPTH=advanced
TAVILY_DEEP_INCLUDE_RAW_CONTENT=markdown
TAVILY_EXTRACT_FORMAT=markdown
TAVILY_EXTRACT_CHUNKS_PER_SOURCE=3

# --- 研究 Agent 边界（一般无需修改） ---
RESEARCH_AGENT_TIMEOUT_SECONDS=30
RESEARCH_AGENT_MAX_MODEL_CALLS=6
RESEARCH_AGENT_MAX_TOOL_CALLS=6
RESEARCH_AGENT_RECURSION_LIMIT=30
RESEARCH_TEMPERATURE=0.2
RESEARCH_MAX_TOKENS=1600

# --- 来源与缓存（一般无需修改） ---
WEB_SEARCH_MAX_SOURCES=6
SOURCE_SNIPPET_MAX_CHARS=1200
USER_SOURCE_SNIPPET_MAX_CHARS=4000
SOURCE_TOTAL_MAX_CHARS=12000
USER_SOURCE_MIN_CHARS=800
USER_SOURCE_TEXT_MAX_CHARS=20000
USER_SOURCE_MAX_URLS=3
WEB_SEARCH_CACHE_TTL_SECONDS=1800

# ===== 异步出题任务 =====
# 前端轮询间隔（毫秒），会随任务状态一起下发
QUIZ_TASK_POLL_INTERVAL_MS=2000
# 单次任务整体超时（秒），覆盖检索 + 生成 + 校验 + 落库
QUIZ_TASK_TIMEOUT_SECONDS=240
# 同时执行的出题任务数，超出后保持 pending 排队
QUIZ_TASK_MAX_CONCURRENCY=2
# 终态任务保留小时数，服务启动时清理更早的记录
QUIZ_TASK_RETENTION_HOURS=24
